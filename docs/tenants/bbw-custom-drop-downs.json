 "leaseStatus_CONTRACT_LIFECYCLE": {
  "_headline": "ASG DOES track lease lifecycle in a firm-defined drop-down, not in the platform Contract Status Code. This substantially answers the contract-lifecycle question.",
  "customCodeTableID": 7727,
  "valueCount": 7,
  "values": [
   "Accounting Purposes Only",
   "Closed",
   "Closed - Active",
   "Future Possession",
   "Open",
   "Possession",
   "Possession - Paying Rent"
  ],
  "comparisonToBRD24": {
   "brd24Sequence": [
    "Open",
    "Active",
    "Possession",
    "Paying Rent",
    "Closed"
   ],
   "matched": {
    "Open": "Open (exact)",
    "Possession": "Possession (exact)",
    "Paying Rent": "'Possession - Paying Rent' (compound)",
    "Closed": "Closed (exact)"
   },
   "notMatched": {
    "Active": "No standalone 'Active' value. 'Active' appears only inside the compound 'Closed - Active'."
   },
   "extraBeyondBRD24": [
    "Accounting Purposes Only",
    "Future Possession"
   ],
   "verdict": "4 of BRD-24's 5 stages are present, one only as a compound. BBW adds 2 stages BRD-24 does not name. So the BRD lifecycle is close to, but not identical with, what the tenant actually runs."
  },
  "orderIsNotStored": "SortOrder is null on every value, so the drop-down renders ALPHABETICALLY, not in lifecycle order. The sequence Open -> Possession -> Paying Rent -> Closed exists only as a convention in users' heads; the platform stores no ordering. A rebuild that models this as an ordered state machine is adding structure the source system does not have.",
  "consequenceForRebuild": "Lifecycle is a FIRM-CONFIGURED code list, not a platform concept. ASG Edge+ must either model it as first-class (and accept it differs per tenant) or migrate these seven values explicitly. The platform Contract Status Code (TableType 2094, three values: Active / AI Abstracted / Inactive) is a different and much coarser axis - both exist simultaneously."
 },
 "leaseAdminRequestType_DRIVES_CONDITIONAL_FIELDS": {
  "_headline": "This is the source list for Issue.LAR_RequestType, the single field driving 44 of 54 conditional-field criteria clauses across the tenant.",
  "customCodeTableID": 7738,
